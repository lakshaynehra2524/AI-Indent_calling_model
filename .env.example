# Copy this file to .env and fill in real values to enable actual email
# sending from the Mail section. Without this, Mail runs in preview-only
# demo mode. Never commit your real .env file.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com
